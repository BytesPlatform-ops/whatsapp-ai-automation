# ─────────────────────────────────────────────────────────────────────────────
# dashboard/ — DEMO / REFERENCE app only. NOT the real Pixie product.
# The real product UI is the Pixie Lab in landing/. This folder is kept as a
# reference for the backend API contracts and is not deployed as the product.
# Copy to `dashboard/.env.local` only if you want to run the demo locally.
# ─────────────────────────────────────────────────────────────────────────────

# App
# Public base URL of this demo (used to build absolute links). Client-visible.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API (Python FastAPI). The demo proxies to it server-side. Server-only.
PIXIE_BACKEND_URL=http://localhost:8000
