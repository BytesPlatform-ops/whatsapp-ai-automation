# ─────────────────────────────────────────────────────────────────────────────
# Pixie backend — Python FastAPI (backend/) environment.
# Copy to `backend/.env` and fill in real values. NEVER commit real secrets.
# This service is server-side only; every value here is a server secret/config.
# Run: cd backend && uvicorn app:app --reload --port 8000
# ─────────────────────────────────────────────────────────────────────────────

# Internal API hardening — shared secret between the Next.js proxy and this
# backend. When set, every request (except public OAuth callbacks + /health) must
# carry a matching `X-Pixie-Internal-Secret` header. MUST be set in production and
# MUST match landing/.env's PIXIE_INTERNAL_API_SECRET. Generate with:
#   openssl rand -hex 32
PIXIE_INTERNAL_API_SECRET=

# Content / AI — model layer. Defaults to a free "fake" provider (tests cost $0).
# Set PIXIE_MODEL_MODE=openai + a real OPENAI_API_KEY to use OpenAI.
PIXIE_MODEL_MODE=fake
PIXIE_LLM_PROVIDER=
PIXIE_AGENT_MODE=
PIXIE_EXECUTION_MODE=
# OPENAI_API_KEY is ALSO used by the AI Receptionist for reply generation, intent
# classification, action extraction, and conversation summarization (fake mode
# uses the deterministic brain, so no key is required to run/test the receptionist).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBED_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# Content Creator (AI Influencer pipeline) — /api/content-creator/*. Ships MOCK,
# DRY-RUN, $0 by default: every var below is OPTIONAL and the safe default makes
# the pipeline runnable with no real spend and no live posting. Durable pipeline
# state uses the shared PIXIE_PERSIST / SUPABASE_* config below (cc_* tables —
# landing migration 0004_content_creator).
# ─────────────────────────────────────────────────────────────────────────────
# Master mock switch. true (default) => all external providers are deterministic
# mocks ($0, no network). Set false ONLY with real Higgsfield creds present.
#   Env: dev/test optional. Secret: no. Missing => mock mode (safe).
CONTENT_CREATOR_MOCK=true
# Posting safety. true (default) => posting adapters never publish live (dry-run).
#   Env: optional. Secret: no. Missing => dry-run (safe).
CONTENT_CREATOR_DRY_RUN=true
# Default billing/provider mode for tenants that haven't chosen one:
#   pixie_managed (default) | client_own_account (BYOK) | prompt_export
#   Env: optional. Secret: no. Missing => pixie_managed.
CONTENT_CREATOR_DEFAULT_PROVIDER_MODE=pixie_managed
# Real video provider name (only read when CONTENT_CREATOR_MOCK=false).
#   Env: optional. Secret: no. Missing => higgsfield.
CONTENT_CREATOR_PROVIDER=higgsfield
# Fernet key (base64, 32 bytes) that seals BYOK provider credentials at rest.
# REQUIRED to store client-own (BYOK) keys when PIXIE_PERSIST is durable — without
# it the backend REFUSES to persist a BYOK secret (never writes plaintext). Make one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Env: production (only if offering BYOK). Secret: YES. Missing => BYOK storage
#   disabled; pixie_managed / prompt_export still work.
CONTENT_CREATOR_SECRET_KEY=

# Higgsfield (real video/image) — OPTIONAL; only read when CONTENT_CREATOR_MOCK=false.
# Any missing piece => provider reports "provider_not_configured" and NEVER silently
# falls back to a live call. Secret: YES for KEY/SECRET.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Model id for video generation. Missing => provider treated as not configured.
HIGGSFIELD_VIDEO_MODEL=
# Generation defaults (safe, overridable). Secret: no.
HIGGSFIELD_ASPECT_RATIO=9:16
HIGGSFIELD_RESOLUTION=720p
# Trends source for idea generation — OPTIONAL. Missing => deterministic mock trends.
TRENDS_API_URL=
TRENDS_API_KEY=

# Supabase (Postgres + Storage). The backend reaches Supabase via the REST API
# using the SERVICE-ROLE key (bypasses RLS). Same Supabase project as the Next
# app. Prisma (in landing/) owns the schema/migrations — see docs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Persistence — where transactional rows live (incl. the Content Creator cc_* tables).
#   memory  = in-process (default; lost on restart — dev/test only)
#   file    = JSON under PIXIE_DATA_DIR (durable, single-instance)
#   supabase= Supabase Postgres (durable, multi-instance) — needs SUPABASE_* above
# Missing => memory. Production should use supabase.
PIXIE_PERSIST=memory
PIXIE_DATA_DIR=.pixie_data
# Guardrail: set to 1 in production so the backend REFUSES to boot on in-memory
# persistence (which loses pipeline state on restart). Off by default so tests/dev
# keep using memory. Secret: no.
PIXIE_REQUIRE_DURABLE=

# Storage — where uploaded media bytes live.
#   supabase (default) = Supabase Storage bucket (needs SUPABASE_* above)
#   local              = on-disk under PIXIE_DATA_DIR
PIXIE_STORAGE_PROVIDER=supabase
PIXIE_STORAGE_BUCKET=pixie-content

# SEO — all optional. Missing keys => audits degrade to deterministic mock data.
PAGESPEED_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
KEYWORD_API_KEY=
RANK_API_KEY=
SERP_API_KEY=
RANK_API_ENDPOINT=
RANK_API_COST_PER_QUERY=
TRENDS_FORCE_MOCK=

# Meta / Facebook / Instagram — OAuth + Graph API. Without app id/secret the
# connect flow shows a "setup required" state (never fake data).
# In PRODUCTION set META_REDIRECT_URI to your public backend callback, e.g.
#   https://api.yourdomain.com/api/meta/connect/callback
# and add the SAME url under Meta App Dashboard → Facebook Login → Valid OAuth
# Redirect URIs. Scopes are hardcoded per-feature in meta/oauth.py; META_SCOPES
# is documented here for reference (the code is the source of truth).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/meta/connect/callback
META_GRAPH_VERSION=v25.0
# AUTHORITATIVE OAuth scopes. When set, the backend requests EXACTLY these (no
# hardcoded scopes are merged in — see meta/oauth.py env_scopes/scopes_for).
# Keep to the safe pre-App-Review set below. After Meta App Review approves the
# advanced scopes, add them back here (no code change needed):
#   pages_manage_posts,pages_manage_engagement,instagram_basic,instagram_content_publish
META_SCOPES=pages_show_list,pages_read_engagement,ads_read,ads_management,business_management
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_INSIGHTS_TOKEN=

# Google (Gmail / Calendar) OAuth — used by the AI Receptionist to read inbound
# customer emails / campaign replies (Gmail) and create appointment events
# (Calendar). Without these, the receptionist stores pending bookings instead of
# creating real calendar events, and run-from-gmail falls back to a mock message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=

# Tests — set to 1 (with real SUPABASE_* creds) to run the live round-trip test.
PIXIE_RUN_SUPABASE_TESTS=

# ─────────────────────────────────────────────────────────────────────────────
# AI Receptionist — optional provider credentials. Every key below is OPTIONAL:
# when a key is absent the matching capability reports "missing_env" and the
# receptionist degrades gracefully (records stored as pending; NO fake sends).
# ─────────────────────────────────────────────────────────────────────────────

# For AI Receptionist — reserved override for a receptionist-specific model;
# currently falls back to OPENAI_MODEL / the default when unset.
AI_RECEPTIONIST_MODEL=

# For AI Receptionist — Stripe secret key for creating REAL payment links (Stripe
# Checkout). Missing → payment requests are stored as pending (never a fake link).
STRIPE_SECRET_KEY=
# For AI Receptionist — Stripe webhook signing secret for payment status updates.
STRIPE_WEBHOOK_SECRET=
# For AI Receptionist — optional redirect URLs used when creating Stripe payment links.
AI_RECEPTIONIST_PAYMENT_SUCCESS_URL=
AI_RECEPTIONIST_PAYMENT_CANCEL_URL=

# For AI Receptionist — Twilio account SID for SMS / WhatsApp / voice channels.
TWILIO_ACCOUNT_SID=
# For AI Receptionist — Twilio auth token for SMS / WhatsApp / voice channels.
TWILIO_AUTH_TOKEN=
# For AI Receptionist — Twilio phone number used for outbound SMS / callbacks.
TWILIO_PHONE_NUMBER=
# For AI Receptionist — Twilio WhatsApp sender (e.g. whatsapp:+14155238886) if WhatsApp is enabled.
TWILIO_WHATSAPP_FROM=

# For AI Receptionist — email provider API key (Resend-compatible) for team
# notifications on escalations / bookings / quotes / support tickets. A connected
# Gmail account also works as a fallback.
EMAIL_PROVIDER_API_KEY=
# For AI Receptionist — sender address for receptionist notification emails.
AI_RECEPTIONIST_FROM_EMAIL=
# For AI Receptionist — internal team inbox where escalations/quotes/bookings/tickets are sent.
AI_RECEPTIONIST_TEAM_EMAIL=

# For AI Receptionist — optional outbound webhook URL for forwarding events
# (new lead/booking/quote/escalation/payment/ticket/opt-out) to a CRM/Zapier/Make.
AI_RECEPTIONIST_WEBHOOK_URL=
# For AI Receptionist — signing secret; when set, outbound webhook bodies are
# HMAC-SHA256 signed in the X-Pixie-Signature header.
AI_RECEPTIONIST_WEBHOOK_SECRET=
