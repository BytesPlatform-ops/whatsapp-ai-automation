{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["../"],
      "@playwright/test": ["../node_modules/playwright/test"]
    }
  },
  "include": ["**/*.ts", "../playwright.config.ts"],
  "exclude": ["../node_modules"]
}
