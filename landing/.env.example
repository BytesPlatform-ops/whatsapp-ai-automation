# ─────────────────────────────────────────────────────────────────────────────
# Pixie Lab — Next.js app (landing/) environment.
# Copy to `landing/.env` and fill in real values. NEVER commit real secrets.
# Rule: only NEXT_PUBLIC_* vars are shipped to the browser — keep every secret
# (service-role key, Stripe secret, API keys) WITHOUT that prefix (server-only).
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
# Comma-separated admin emails that may access /admin-panel (server-only).
ADMIN_EMAILS=

# Supabase (auth + Postgres). URL + anon key are safe to expose (client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — FULL DB access. SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database / Prisma (Supabase Postgres). DATABASE_URL = transaction pooler
# (pgbouncer, port 6543) for the app; DIRECT_URL = session pooler (port 5432)
# for migrations. Both server-only.
DATABASE_URL=
DIRECT_URL=

# Backend API (Python FastAPI: SEO / Meta / Content services)
# SERVER-ONLY on purpose: the browser never calls FastAPI directly — Next route
# handlers under app/api/lab/* proxy to it and resolve the tenant server-side.
# So there is intentionally NO NEXT_PUBLIC_BACKEND_API_URL.
PIXIE_BACKEND_URL=http://localhost:8000
# Shared secret sent to the backend as `X-Pixie-Internal-Secret` (server-only).
# MUST match backend/.env's PIXIE_INTERNAL_API_SECRET. Generate with: openssl rand -hex 32
PIXIE_INTERNAL_API_SECRET=

# Content / AI (server-only)
OPENAI_API_KEY=

# SEO tools (server-only; used by the /admin tools + backend)
OPEN_PAGERANK_API_KEY=

# Stripe. Secret + webhook secret are server-only; publishable key is client-safe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

# Email / SMTP (server-only)
RESEND_API_KEY=
RESEND_FROM=
# Where Pixie "request access" + waitlist leads are emailed.
PIXIE_REQUEST_EMAIL=
WAITLIST_LEAD_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# The variables below are consumed by the PYTHON backend (backend/.env), NOT by
# Next. Listed in backend/.env.example. Kept out of this file to avoid confusion:
#   Supabase storage/persistence: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#     PIXIE_PERSIST, PIXIE_STORAGE_PROVIDER, PIXIE_STORAGE_BUCKET
#   Meta: META_APP_ID, META_APP_SECRET, META_REDIRECT_URI, META_GRAPH_VERSION,
#     META_WEBHOOK_VERIFY_TOKEN
#   SEO: PAGESPEED_API_KEY, DATAFORSEO_LOGIN/PASSWORD, RANK_API_KEY, SERP_API_KEY
# ─────────────────────────────────────────────────────────────────────────────
